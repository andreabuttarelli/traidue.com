# Server-side (private)
GEMINI_API_KEY=

# Site identity (public) — host-aware branding/SEO.
# Leave unset to use the Tra i Due (traidue.com) defaults.
# For a second deployment (e.g. transwiki.co) set these in that Vercel project:
#   PUBLIC_SITE_URL=https://www.transwiki.co
#   PUBLIC_SITE_DOMAIN=transwiki.co
#   PUBLIC_SITE_BRAND=TransWiki
#   PUBLIC_CONTACT_EMAIL=info@transwiki.co
#   PUBLIC_INSTAGRAM_URL=https://www.instagram.com/...
# (The GitHub repo link is the same for every deployment and is hardcoded in src/lib/site.ts.)
PUBLIC_SITE_URL=
PUBLIC_SITE_DOMAIN=
PUBLIC_SITE_BRAND=
PUBLIC_CONTACT_EMAIL=
PUBLIC_INSTAGRAM_URL=

# Client-side (public) - Firebase
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
